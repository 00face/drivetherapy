{
  "name": "drive-therapy",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "rehost": "npm run build && FRESH_PORT=1 NODE_ENV=production tsx server.ts",
    "build": "npm run clean && vite build",
    "build:portable-bundle": "npm run build && tsx scripts/buildPortable.ts",
    "build:android": "npm run build && node scripts/buildAndroidScaffold.mjs",
    "build:electron:linux": "npm run build:portable-bundle && npx esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=electron/main.js --external:electron && npx electron-builder --config electron-builder.yml --linux",
    "build:electron:win": "npm run build:portable-bundle && npx esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=electron/main.js --external:electron && npx electron-builder --config electron-builder.yml --win",
    "build:electron:mac": "npm run build:portable-bundle && npx esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=electron/main.js --external:electron && npx electron-builder --config electron-builder.yml --mac",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "formats:build": "tsx scripts/formatDbTool.ts build",
    "formats:stats": "tsx scripts/formatDbTool.ts stats",
    "formats:validate": "tsx scripts/formatDbTool.ts validate",
    "formats:lookup": "tsx scripts/formatDbTool.ts lookup",
    "qa:probe": "tsx scripts/qaProbe.ts",
    "qa:e2e": "node scripts/e2eSmokeProbe.mjs",
    "qa:browser": "node scripts/playwrightSmoke.mjs",
    "qa:release-audit": "node scripts/generateReleaseReadiness.mjs",
    "oauth:import-secret": "node scripts/importOAuthSecret.mjs",
    "gcp:setup": "bash scripts/gcpBootstrap.sh"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@huggingface/transformers": "^4.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
